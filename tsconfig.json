{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "monaco-vs/*": [
        "./node_modules/monaco-editor/esm/vs/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
